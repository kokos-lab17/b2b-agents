# ==============================================================================
# Environment Configuration Template for Autonomous B2B Multi-Agent Procurement
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Groq AI Model Configuration (Feature 1, 2, 9)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# PayPal Sandbox Configuration (Feature 6)
# Obtain credentials from developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Persistence Storage (Feature 5)
# Note: On Render, configure a Persistent Disk if database persistence across deploys is required.
DATABASE_PATH=procurement_memory.db

# Token and Call Budgeting Limits (Feature 9)
MAX_SESSION_TOKENS=15000
MAX_MODEL_CALLS=12
MAX_AGENT_CALLS=4
MAX_NEGOTIATION_ROUNDS=3
MAX_OUTPUT_TOKENS=300

# Reliability and Network Timeouts
REQUEST_TIMEOUT_SECONDS=20.0
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=1.5

# CORS Configuration
FRONTEND_ALLOWED_ORIGIN=*
